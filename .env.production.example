NODE_ENV=production
POSTGRES_USER=sabeghoono_user
POSTGRES_PASSWORD=replace-with-a-new-strong-password
POSTGRES_DB=sabeghoono_db
JWT_SECRET=replace-with-a-long-random-secret
NATIONAL_ID_SALT=replace-with-a-long-random-salt
ADMIN_DEFAULT_USERNAME=admin
# 8+ chars with upper, lower, digit and symbol. Leave EMPTY to get a random one printed once in the api log.
ADMIN_DEFAULT_PASSWORD=
API_IR_BASE_URL=https://s.api.ir
API_IR_KEY=

# Encrypts third-party API keys saved from the admin panel (any long random string)
ENCRYPTION_KEY=

# --- v15: security / monitoring (all optional) ---
TRUST_PROXY=2
CORS_ORIGINS=
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_PANEL_URL=https://admin.sabegheno.ir

# --- v16: panel host + paid self-report ---
FRONTEND_URL=https://app.sabegheno.ir
ZARINPAL_MERCHANT_ID=
REPORT_PRICE_TOMAN=15000

# --- partners (optional) ---
API_IR_TIMEOUT_MS=15000
ONTIME24_BASE_URL=
ONTIME24_ADMIN_USERNAME=
ONTIME24_ADMIN_PASSWORD=
