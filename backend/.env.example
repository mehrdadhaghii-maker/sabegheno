# --- Server ---
PORT=4000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string
# access-token lifetime (the session itself idles out after SESSION_IDLE_MINUTES)
ACCESS_TOKEN_TTL=15m
NATIONAL_ID_SALT=change-this-too

# --- Database (PostgreSQL) ---
# For running Node directly on the host, use localhost.
# When using docker compose, the api service overrides this to use host `db`.
# For production, swap this for a managed Postgres URL.
DATABASE_URL="postgresql://sabegheno:sabegheno@localhost:5432/sabegheno?schema=public"

# --- api.ir (s.api.ir) ---
# One account/key covers everything from this provider: bounced checks,
# active loans, Shahkar (mobile/national-ID match), PersonInfo (civil
# registry), PostalCodeInfo, and SmsOTP delivery.
API_IR_BASE_URL=https://s.api.ir
API_IR_KEY=
API_IR_TIMEOUT_MS=15000

# --- Ontime24 (Payment/Wallet + Score — not yet implemented, docs pending) ---
ONTIME24_BASE_URL=https://api.ontime24.ir
ONTIME24_ADMIN_USERNAME=
ONTIME24_ADMIN_PASSWORD=

# --- Sabegheno platform admin (seeded once via npm run prisma:seed) ---
ADMIN_DEFAULT_USERNAME=admin
# 8+ chars with upper, lower, digit and symbol — leave empty to get a random one printed once by the seed
ADMIN_DEFAULT_PASSWORD=

# --- v15: sessions & lockout (defaults shown) ---
SESSION_IDLE_MINUTES=30
REFRESH_TOKEN_DAYS=7
MAX_FAILED_LOGINS=5
LOCK_HOURS=48
OTP_MAX_ATTEMPTS=5

# --- v15: CORS / proxy / rate limits ---
# Comma-separated front-end origins. Empty in development = localhost only; empty in production = same-origin only.
CORS_ORIGINS=
TRUST_PROXY=1
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_API_MAX=1200

# --- v15: monitoring ---
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_PANEL_URL=http://localhost:5174

# --- v15: data retention ---
HARD_DELETE_AFTER_DAYS=30
INACTIVE_ACCOUNT_MONTHS=12

# --- v16: paid self-report for natural persons ---
# Empty merchant id: development uses a FAKE gateway; production answers "gateway not configured".
FRONTEND_URL=http://localhost:5173
ZARINPAL_MERCHANT_ID=
REPORT_PRICE_TOMAN=15000
REPORT_ACCESS_HOURS=24
